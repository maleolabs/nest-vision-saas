# .env — copy ke .env lalu edit sesuai environment
# Dipakai oleh scripts/run.ps1 (auto-load), scripts/run.bat (auto-load),
# dan bisa di-source manual di bash: set -a; source .env; set +a
# Semua key opsional — kalau kosong, pakai default dari application.properties

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/ocr_tool?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=ocr
SPRING_DATASOURCE_PASSWORD=ocr
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- Tesseract OCR ---
TESSERACT_DATAPATH=C:\tessdata
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD kosong = auto-detect (PATH, Program Files, scoop/choco)

# --- Python OCR bridge ---
# Path python interpreter (python3 di linux, py/python di windows)
OCR_PYTHON_PATH=python3
# Path skrip OCR utama (relatif dari repo root atau absolut)
OCR_SCRIPT_PATH=opt/app/ocr/tesseract_ocr.py

# --- Preprocessing (blur/gelap/kontras rendah) ---
# Auto-preprocess gambar buram sebelum OCR
OCR_PREPROCESSING_ENABLED=true
# Lebar minimal px; di bawah ini gambar di-upscale 2-2.5x (Tesseract butuh ~300 DPI)
OCR_UPSCALE_THRESHOLD=1000
# Ambang Laplacian variance; < nilai ini dianggap blur
OCR_BLUR_THRESHOLD=100

# --- Ensemble fallback (pyTesseract -> native Tesseract -> RapidOCR -> PaddleOCR) ---
OCR_ENSEMBLE_FALLBACK=true
# Confidence minimum (0-100); di bawah ini trigger fallback engine berikutnya
OCR_CONF_THRESHOLD=55
OCR_TIME_BUDGET=60

# --- PaddleOCR fallback (legacy) ---
# Butuh: pip install paddlepaddle paddleocr
OCR_PADDLE_ENABLED=false
OCR_PADDLE_SCRIPT=opt/app/ocr/paddle_ocr.py

# --- RapidOCR ONNX fallback (preferred untuk KTP buram) ---
# Butuh: pip install rapidocr_onnxruntime pyclipper shapely onnxruntime
OCR_RAPID_ENABLED=true
OCR_RAPID_SCRIPT=opt/app/ocr/rapid_ocr.py

# --- Super-resolution (blur ekstrem, variance < 50) ---
# EDSR model opsional (.pb). Kosong = pakai cubic+sharpen (capped 2200px)
OCR_SR_ENABLED=true
ESRGAN_MODEL=

# --- Koreksi miring / perspective / orientasi ---
# Warp trapesium KTP jadi persegi (foto dari sudut)
OCR_PERSPECTIVE_ENABLED=true
# Deteksi rotasi 90/180/270 via Tesseract OSD + brute-force
OCR_OSD_ENABLED=true
# Sudut deskew maksimum derajat (Hough lines, 10-45)
OCR_DESKEW_MAX_ANGLE=45

# --- LLM Vision fallback (opsional, berbayar) ---
# Butuh API key provider OpenAI-compatible (OpenAI/Qwen/Ollama local)
OCR_LLM_ENABLED=false
OCR_LLM_API_KEY=
OCR_LLM_BASE_URL=https://api.openai.com/v1
OCR_LLM_MODEL=gpt-4o-mini

# --- Keystore (JCEKS) ---
KEYSTORE_PASSWORD=changeit
KEYSTORE_ALIAS=ocr

# --- Mail ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=dev@example.com
SPRING_MAIL_PASSWORD=dev

# --- Server ---
SERVER_PORT=8080
