version: '3.8'

services:
  ocr-api:
    build: .
    container_name: ocr-api
    ports:
      - "8080:8080"
    environment:
      - SERVER_SERVLET_SESSION_TIMEOUT=1500m
      - SPRING_CONFIG_ADDITIONAL_LOCATION=/lib/x86_64-linux-gnu

      # Database Configuration
      - SPRING_DATASOURCE_DRIVER-CLASS-NAME=${SPRING_DATASOURCE_DRIVER-CLASS-NAME}
      - SPRING_DATASOURCE_USERNAME=${SPRING_DATASOURCE_USERNAME}
      - SPRING_DATASOURCE_PASSWORD=${SPRING_DATASOURCE_PASSWORD}
      - SPRING_DATASOURCE_URL=${SPRING_DATASOURCE_URL}

      # JPA & Hibernate
      - SPRING_JPA_HIBERNATE_DDL-AUTO=update

      # Tesseract OCR Configuration
      - TESSERACT_DATAPATH=/usr/share/tesseract-ocr/5/tessdata/

      # Python OCR bridge
      - OCR_PYTHON_PATH=${OCR_PYTHON_PATH:-python3}
      - OCR_SCRIPT_PATH=${OCR_SCRIPT_PATH:-opt/app/ocr/tesseract_ocr.py}

      # OCR Preprocessing (blur/gelap/kontras rendah)
      - OCR_PREPROCESSING_ENABLED=${OCR_PREPROCESSING_ENABLED:-true}
      - OCR_UPSCALE_THRESHOLD=${OCR_UPSCALE_THRESHOLD:-1000}
      - OCR_BLUR_THRESHOLD=${OCR_BLUR_THRESHOLD:-100}

      # OCR Ensemble fallback (pyTesseract -> native Tesseract -> PaddleOCR)
      - OCR_ENSEMBLE_FALLBACK=${OCR_ENSEMBLE_FALLBACK:-true}
      - OCR_CONF_THRESHOLD=${OCR_CONF_THRESHOLD:-60}

      # PaddleOCR fallback (butuh pip install paddlepaddle paddleocr di image)
      - OCR_PADDLE_ENABLED=${OCR_PADDLE_ENABLED:-false}
      - OCR_PADDLE_SCRIPT=${OCR_PADDLE_SCRIPT:-opt/app/ocr/paddle_ocr.py}

      # Super-resolution (blur ekstrem; EDSR model opsional, mount via volumes)
      - OCR_SR_ENABLED=${OCR_SR_ENABLED:-false}
      - ESRGAN_MODEL=${ESRGAN_MODEL:-}

      # Koreksi miring / perspective / orientasi
      - OCR_PERSPECTIVE_ENABLED=${OCR_PERSPECTIVE_ENABLED:-true}
      - OCR_OSD_ENABLED=${OCR_OSD_ENABLED:-true}
      - OCR_DESKEW_MAX_ANGLE=${OCR_DESKEW_MAX_ANGLE:-45}

      # LLM Vision fallback (opsional, berbayar)
      - OCR_LLM_ENABLED=${OCR_LLM_ENABLED:-false}
      - OCR_LLM_API_KEY=${OCR_LLM_API_KEY:-}
      - OCR_LLM_BASE_URL=${OCR_LLM_BASE_URL:-https://api.openai.com/v1}
      - OCR_LLM_MODEL=${OCR_LLM_MODEL:-gpt-4o-mini}

      # API Key Configuration
      - APP_API-KEY_LENGTH=32
      - APP_API-KEY_LIFETIME=180

      # Thread Pool Configuration
      - PHYSICAL-DEVICE_CORE-POOL=3
      - PHYSICAL-DEVICE_MAX-POOL=5
      - PHYSICAL-DEVICE_QUEUE-CAPACITY=50

      # File Upload Configuration
      - FILE_UPLOAD-METHOD=local
      - FILE_UPLOAD-DIR=uploads/ocr-request
      - FILE_EXTERNAL-API-URL=
      - FILE_EXTERNAL-API-KEY=

      # Keystore Configuration
      - KEYSTORE_PASSWORD=${KEYSTORE_PASSWORD}
      - KEYSTORE_ALIAS=${KEYSTORE_ALIAS}

      # Account Limits
      - ACCOUNT_PERSONAL_DAILY-LIMIT=20
      - ACCOUNT_ORGANIZATION_DAILY-LIMIT=50

      # Email Configuration
      - SPRING_MAIL_HOST=smtp.gmail.com
      - SPRING_MAIL_PORT=587
      - SPRING_MAIL_USERNAME=${SPRING_MAIL_USERNAME}
      - SPRING_MAIL_PASSWORD=${SPRING_MAIL_PASSWORD}
      - SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
      - SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
    restart: unless-stopped